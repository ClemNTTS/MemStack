# Node-only content report worker. Never use a VITE_ prefix for secrets.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Set FIREBASE_SERVICE_ACCOUNT as a GitHub Actions secret (JSON service account).
# Local use requires the same JSON in this environment variable.
FIREBASE_SERVICE_ACCOUNT=

# Public frontend switches. Never put a provider API key in a VITE_ variable.
# Enable only after deploying/configuring the challenge analysis function.
VITE_CHALLENGE_AI_ENABLED=false
# Local tests only: demo-memstack Auth/Firestore/Functions emulators.
VITE_FIREBASE_EMULATORS=false
# Public reCAPTCHA site key for Firebase App Check, if configured.
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_PROVIDER=enterprise
