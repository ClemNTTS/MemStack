{
  "name": "memstack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test src/review/*.test.ts src/components/*.test.ts src/progress/*.test.ts src/reports/*.test.ts src/challenges/*.test.ts src/data/catalog/*.test.ts scripts/content-reports/*.test.mjs functions/src/*.test.mjs tests/challenge-ai/provider-contract.test.mjs tests/challenge-ai/client-server-contract.test.mjs tests/challenge-ai/qualification.test.mjs",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "test:challenge-rules": "npm --prefix tests/challenge-ai test",
    "reports:process": "node --env-file-if-exists=.env scripts/content-reports/run.mjs",
    "reports:check": "node scripts/content-reports/run.mjs --check",
    "ai:qualification": "node tests/challenge-ai/qualification.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.53.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
