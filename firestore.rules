rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function isoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
    }
    match /users/{uid}/challengeAttempts/{attemptId} {
      function validLegacyAttempt(data) {
        return data.keys().hasAll(['version', 'challengeVersion', 'challengeId', 'answer', 'submittedAt', 'outcome'])
          && data.keys().hasOnly(['version', 'challengeVersion', 'challengeId', 'answer', 'submittedAt', 'outcome'])
          && data.version is int && data.version == 1
          && data.challengeVersion is int && data.challengeVersion == 1
          && data.challengeId in ['docker-images-diagnostic', 'docker-volumes-diagnostic', 'docker-ports-diagnostic']
          && data.answer is string && data.answer.size() >= 1 && data.answer.size() <= 4000
          && data.answer.matches('[\\s\\S]*\\S[\\s\\S]*')
          && data.submittedAt is timestamp
          && data.outcome in ['', 'retry', 'understood'];
      }
      function validAttempt(data) {
        return validLegacyAttempt(data) || (
          data.keys().hasAll(['version', 'challengeVersion', 'challengeId', 'answer', 'observations', 'actions', 'submittedAt', 'outcome'])
          && data.keys().hasOnly(['version', 'challengeVersion', 'challengeId', 'answer', 'observations', 'actions', 'submittedAt', 'outcome'])
          && data.version is int && data.version == 2
          && data.challengeVersion is int && data.challengeVersion == 2
          && data.challengeId in ['docker-images-diagnostic', 'docker-volumes-diagnostic', 'docker-ports-diagnostic']
          && data.observations is string && data.observations.size() >= 1 && data.observations.size() <= 2000
          && data.observations.matches('[\\s\\S]*\\S[\\s\\S]*')
          && data.actions is string && data.actions.size() >= 1 && data.actions.size() <= 2000
          && data.actions.matches('[\\s\\S]*\\S[\\s\\S]*')
          && data.answer is string && data.answer.size() <= 4000
          && data.answer == data.observations + '\n\n' + data.actions
          && data.submittedAt is timestamp
          && data.outcome in ['', 'retry', 'understood']
        );
      }
      allow read: if owner(uid);
      allow create: if owner(uid)
        && attemptId.matches('^[a-zA-Z0-9-]{1,128}$')
        && validAttempt(request.resource.data)
        && request.resource.data.submittedAt == request.time
        && request.resource.data.outcome == '';
      allow update: if owner(uid)
        && validAttempt(request.resource.data)
        && resource.data.outcome == ''
        && request.resource.data.outcome in ['retry', 'understood']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outcome']);
      // Answers and server timestamps are immutable; no client deletion.
    }
    match /users/{uid}/challengeAnalyses/{attemptId} {
      allow read: if owner(uid);
      // Only trusted server code writes feedback; counters remain denied by default.
    }
    match /users/{uid}/contentReports/{reportId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && reportId.matches('^[a-zA-Z0-9-]{1,128}$')
        && request.resource.data.keys().hasAll(['version', 'lessonId', 'cardId', 'kind', 'comment', 'contentSnapshot', 'contentVersion', 'createdAt', 'status'])
        && request.resource.data.keys().hasOnly(['version', 'lessonId', 'cardId', 'kind', 'comment', 'contentSnapshot', 'contentVersion', 'createdAt', 'status'])
        && request.resource.data.version is int && request.resource.data.version == 1
        && request.resource.data.lessonId is string
        && request.resource.data.lessonId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.lessonId.size() <= 128
        && request.resource.data.cardId is string && request.resource.data.cardId.size() <= 128
        && (request.resource.data.cardId == '' || request.resource.data.cardId.matches('^[a-z0-9]+(-[a-z0-9]+)*$'))
        && request.resource.data.kind in ['factual', 'unclear', 'code', 'other']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 1 && request.resource.data.comment.size() <= 2000
        && request.resource.data.contentSnapshot is string
        && request.resource.data.contentSnapshot.size() >= 1 && request.resource.data.contentSnapshot.size() <= 12000
        && request.resource.data.contentVersion is string
        && request.resource.data.contentVersion.matches('^[a-f0-9]{64}$')
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending';
      // Updates belong to the trusted worker; client reports are immutable.
    }
    match /users/{uid}/settings/learning {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasAll(['version', 'activeCourseId', 'dailyLessonGoal'])
        && request.resource.data.keys().hasOnly(['version', 'activeCourseId', 'dailyLessonGoal'])
        && request.resource.data.version is int && request.resource.data.version == 1
        && request.resource.data.activeCourseId is string
        && request.resource.data.activeCourseId.size() >= 1 && request.resource.data.activeCourseId.size() <= 128
        && request.resource.data.activeCourseId.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.dailyLessonGoal is int
        && request.resource.data.dailyLessonGoal >= 1 && request.resource.data.dailyLessonGoal <= 10;
    }
    match /users/{uid}/lessons/{lessonId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['completedAt'])
        && isoDate(request.resource.data.completedAt);
    }
    match /users/{uid}/cards/{cardId} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['cardId', 'intervalDays', 'lastReviewedAt', 'dueAt'])
        && request.resource.data.cardId == cardId
        && request.resource.data.intervalDays is int
        && request.resource.data.intervalDays >= 1 && request.resource.data.intervalDays <= 365
        && isoDate(request.resource.data.lastReviewedAt) && isoDate(request.resource.data.dueAt);
    }
    match /users/{uid}/reviews/{eventId} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['cardId', 'rating', 'reviewedAt', 'kind'])
        && request.resource.data.cardId is string && request.resource.data.cardId.size() <= 128
        && request.resource.data.rating in ['recalled', 'forgotten']
        && request.resource.data.kind in ['new', 'review']
        && isoDate(request.resource.data.reviewedAt);
    }
  }
}
